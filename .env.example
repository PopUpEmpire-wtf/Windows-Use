# Windows-Use Environment Configuration
# Copy this file to .env and fill in your values.

# ──────────────────────────────────────────────────────────────────────────────
# LLM API Keys — set at least one
# ──────────────────────────────────────────────────────────────────────────────

# Anthropic (Claude)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Mistral
# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Groq
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ──────────────────────────────────────────────────────────────────────────────
# ClickUp Integration
# ──────────────────────────────────────────────────────────────────────────────

# ClickUp personal API token (required for ClickUp integration)
# Get from: https://app.clickup.com/settings/apps
CLICKUP_API_KEY=

# Shared secret for HMAC-SHA256 webhook signature verification (recommended)
# Copy from: ClickUp → Settings → Integrations → Webhooks → <your webhook> → Secret
CLICKUP_WEBHOOK_SECRET=

# Tag name used to mark tasks the agent should process (default: windows-agent)
CLICKUP_TASK_TAG=windows-agent

# Mention name used to trigger the agent via comments (default: windows-agent)
# A comment starting with @windows-agent will be processed.
CLICKUP_BOT_NAME=windows-agent

# Webhook server bind address and port
CLICKUP_WEBHOOK_HOST=0.0.0.0
CLICKUP_WEBHOOK_PORT=8000
